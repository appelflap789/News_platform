# Copy this file to ".env" (same folder) - or simply paste your key on the Settings page of the dashboard,
# which writes this file for you.

# Anthropic API key. Needed for: Claude source analysis, topic term suggestions, briefings, AI summaries.
# Scraping, search and topics work without it. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: where the dashboard listens, and where the database lives.
# NSP_HOST=127.0.0.1
# NSP_PORT=8765
# NSP_DATA_DIR=data
